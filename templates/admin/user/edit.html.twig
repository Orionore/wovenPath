{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin_user') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('admin_user') }}
{% endblock %}

{% block main %}
    <div class="container">
        <div class="card-header">
            <h1>Modifier les rôles de {{ user.username }}</h1>
            <div>
                <a href="{{ path('app_admin_user_index') }}" class="btn-primary">Retour à la liste</a>
                <a href="{{ path('app_admin_user_show', {'id': user.id}) }}" class="btn-primary">Voir</a>
            </div>
        </div>
        <div class="card-body">
            {{ include('admin/user/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>
{% endblock %}