{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('admin_user') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('admin_user') }}
{% endblock %}

{% block main %}
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h1 class="h3 mb-0">Modifier les rôles de {{ user.username }}</h1>
            <div>
                <a href="{{ path('app_admin_user_index') }}" class="btn btn-secondary btn-sm">Retour à la liste</a>
                <a href="{{ path('app_admin_user_show', {'id': user.id}) }}" class="btn btn-info btn-sm">Voir</a>
            </div>
        </div>
        <div class="card-body">
            {{ include('admin/user/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>
{% endblock %}