{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="mb-4 {% if label == 'success' %}bg-green-100 border-l-4 border-green-500 text-green-700{% elseif label == 'error' %}bg-red-100 border-l-4 border-red-500 text-red-700{% else %}bg-blue-100 border-l-4 border-blue-500 text-blue-700{% endif %} p-4">
            <p>{{ message }}</p>
        </div>
    {% endfor %}
{% endfor %}