{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_profile_edit') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_profile_edit') }}
{% endblock %}

{% block title %}Modifier le profil{% endblock %}

{% block main %}
    <section class="container">
            <h1>Modifier votre profil</h1>

            {{ form_start(form, {'attr': {'class': 'profile-edit-form'}}) }}
            <div class="username-container">
                    {{ form_row(form.username) }}
            </div>

            <div class="form-group">
                <a href="{{ path('app_profile') }}" class="btn-primary">Annuler</a>
                <button type="submit" class="btn-primary">Enregistrer les modifications</button>
            </div>
            {{ form_end(form) }}
            
            <div class="edit-password-container">
                <p>Mot de passe oublié ?</p>
                <a href="{{ path('app_forgot_password_request') }}" >Modifier le mot de passe</a>
            </div>

    </section>
{% endblock %}