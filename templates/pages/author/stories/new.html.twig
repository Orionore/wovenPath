{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_author_new_story') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_author_new_story') }}
{% endblock %}

{% block title %}Créer une nouvelle histoire{% endblock %}

{% block main %}
    <div class="container">
        {% include 'partials/main_nav.html.twig' with {
            'title': 'Créer une nouvelle histoire',
            'return_path': path('app_author_stories_index'),
            'return_text': 'Retour à la liste',
        } %}

        <div class="form-story-container content-container">
            {{ form_start(form) }}

            {# ****** title ****** #}
            <div class="form-title-container">
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_help(form.title) }}
                {{ form_errors(form.title, {'errors_attr': {'class': 'form-error'}}) }}
            </div>

            {# ****** description ****** #}
            <div class="form-description-container">
                {{ form_label(form.description) }}
                {{ form_widget(form.description) }}
                {{ form_help(form.description) }}
                {{ form_errors(form.description, {'errors_attr': {'class': 'form-error'}}) }}
            </div>

            {# ****** genre ****** #}
            <div class="form-genre-container">
                {{ form_label(form.genre) }}
                {{ form_widget(form.genre) }}
                {{ form_help(form.genre) }}
                {{ form_errors(form.genre, {'errors_attr': {'class': 'form-error'}}) }}
            </div>

            {# ****** images ****** #}
            <div class="story-image-preview">
                {{ form_label(form.imageFile) }}
                <div {{ stimulus_controller('story-image-preview') }} class="mt-1">
                    {% if story.imageName is defined and story.imageName %}
                        <div class="mb-3">
                            <p class="text-sm text-gray-600 mb-1" id="current-image-desc">Image actuelle:</p>
                            <img src="{{ asset('uploads/stories/' ~ story.imageName) }}"
                                 alt="{{ story.title }}"
                                 class="max-h-48 rounded"
                                 aria-labelledby="current-image-desc">
                        </div>
                    {% endif %}

                    <div class="custom-file-upload">
                        {{ form_widget(form.imageFile, {
                            'attr': {
                                'data-story-image-preview-target': 'input',
                                'data-action': 'story-image-preview#preview'
                            }
                        }) }}
                        <label for="{{ form.imageFile.vars.id }}" class="file-label">
                            <span class="button" role="button" tabindex="0">Choisir un fichier</span>
                            <span class="file-name" data-story-image-preview-target="fileName" aria-live="polite">
                                Aucun fichier choisi
                            </span>
                        </label>
                    </div>
                    {{ form_help(form.imageFile) }}
                    <div data-story-image-preview-target="preview">
                        <img src="#" data-story-image-preview-target="image" alt="Aperçu de l'image sélectionnée">
                    </div>
                    {{ form_errors(form.imageFile, {'attr': {'class': 'form-error'}}) }}
                </div>
            </div>

            {# ****** set publish ****** #}
            <div class="checkbox-wrapper">
                {{ form_widget(form.status) }}
                {{ form_label(form.status) }}
                {{ form_help(form.status) }}
                {{ form_errors(form.status, {'errors_attr': {'class': 'form-error'}}) }}
            </div>

            <div class="flex justify-end">
                <button type="submit" class="btn-primary" aria-label="Enregistrer l'histoire">
                    Enregistrer les modifications
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}