{% extends 'layouts/profile.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_chapter') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_chapter') }}
{% endblock %}

{% block title %}{{ chapter.title }} - {{ story.title }}{% endblock %}

{% block main %}
    <div class="container">

        {% include 'partials/main-nav.html.twig' with {
            'title': 'Chapitre ' ~ chapter.position ~ ', ' ~ chapter.title  ~ ' - ' ~ story.title,
            'return_path': path('app_profile_stories_index'),
            'return_text': 'Retour à la liste',
            'actions': [
                {
                    'path': path('app_story_chapters', {'id': story.id}),
                    'text': 'Gérer les chapitres',
                    'class': 'btn btn-secondary',
                    'condition': app.user and app.user.id == story.userId
                },
                {
                    'path': path('app_chapter_edit', {'id': chapter.id}),
                    'text': 'Modifier',
                    'class': 'btn btn-primary',
                    'condition': app.user and app.user.id == story.userId
                }
            ]
        } %}

        {% include 'includes/flash_messages.html.twig' %}

        <div class="row">
            <div class="col-md-10 mx-auto">

                <div class="card mb-5">
                    <div class="card-body">
                        <div class="chapter-content">
                            {{ chapter.content|nl2br }}
                        </div>
                    </div>
                </div>

                <div class="navigation-controls d-flex justify-content-between mb-4">
                    {% if previousChapter %}
                        <a href="{{ path('app_chapter_read', {'id': previousChapter.id}) }}" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left"></i> Chapitre précédent
                        </a>
                    {% else %}
                        <a href="{{ path('app_story_show', {'id': story.id}) }}" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Retour à l'histoire
                        </a>
                    {% endif %}

                    {% if nextChapter %}
                        <a href="{{ path('app_chapter_read', {'id': nextChapter.id}) }}" class="btn btn-outline-primary">
                            Chapitre suivant <i class="bi bi-arrow-right"></i>
                        </a>
                    {% else %}
                        <a href="{{ path('app_story_show', {'id': story.id}) }}" class="btn btn-outline-secondary">
                            Fin de l'histoire <i class="bi bi-arrow-right"></i>
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}