{% extends 'layouts/profile.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_chapter') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_chapter') }}
{% endblock %}

{% block title %}Chapitres de {{ story.title }}{% endblock %}

{% block main %}

    <div class="container">

        {% include 'partials/main_nav.html.twig' with {
            'title': 'Chapitres de ' ~ story.title,
            'return_path': path('app_author_stories_show', {'id': story.id}),
            'return_text': 'Retour à l\'histoire',
            'actions': [
                {
                    'path': path('app_author_chapter_new', {'id': story.id}),
                    'text': 'Ajouter un chapitre'
                }
            ]
        } %}

        {% include 'includes/flash_messages.html.twig' %}

        <div class="content-container">
            {% if chapters|length > 0 %}
                <div class="list-group">
                    {% for chapter in chapters %}
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <a href="{{ path('app_chapter_read', {'id': chapter.id}) }}" class="text-decoration-none">
                                    <h5 class="mb-1">{{ chapter.position }}. {{ chapter.title }}</h5>
                                </a>
                                <small>Créé le {{ chapter.createdAt|date('d/m/Y H:i') }}</small>
                            </div>

                            {% if app.user and app.user.id == story.userId %}
                                <div class="btn-group">
                                    <form method="post" action="{{ path('app_author_chapter_move', {'id': chapter.id, 'direction': 'up'}) }}" class="d-inline">
                                        <button class="btn btn-sm btn-outline-secondary" {% if chapter.position == 1 %}disabled{% endif %}>
                                            Monter la position du chapitre
                                        </button>
                                    </form>

                                    <form method="post" action="{{ path('app_author_chapter_move', {'id': chapter.id, 'direction': 'down'}) }}" class="d-inline">
                                        <button class="btn btn-sm btn-outline-secondary" {% if loop.last %}disabled{% endif %}>
                                            Descendre la position du chapitre
                                        </button>
                                    </form>

                                    <a href="{{ path('app_author_chapter_edit', {'id': chapter.id}) }}" class="btn btn-sm btn-outline-primary">
                                        Éditer le chapitre
                                    </a>

                                    <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ chapter.id }}">
                                        Supprimer le chapitre
                                    </button>
                                </div>

                                <!-- Modal confirmation to delete -->
                                <div class="modal fade" id="deleteModal{{ chapter.id }}" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="deleteModalLabel">Confirmation de suppression</h5>
                                                <button type="button" class="btn" data-bs-dismiss="modal" aria-label="Close">
                                                    Annuler
                                                </button>
                                            </div>
                                            <div class="modal-body">
                                                Êtes-vous sûr de vouloir supprimer le chapitre "{{ chapter.title }}" ?
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                                                <form method="post" action="{{ path('app_author_chapter_delete', {'id': chapter.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ chapter.id) }}">
                                                    <button type="submit" class="btn btn-danger">Supprimer</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="alert alert-info">
                    Cette histoire n'a pas encore de chapitres.
                    {% if app.user and app.user.id == story.userId %}
                        <a href="{{ path('app_author_chapter_new', {'id': story.id}) }}">Cliquez ici pour ajouter le premier chapitre</a>.
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}