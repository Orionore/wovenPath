{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_new_chapter') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_new_chapter') }}
{% endblock %}

{% block title %}Nouveau chapitre pour {{ story.title }}{% endblock %}

{% block main %}
    <div class="container">

    {% include 'partials/main_nav.html.twig' with {
        'title': 'Nouveau chapitre pour ' ~ story.title,
        'return_path': path('app_author_story_chapters', {'id': story.id}),
        'return_text': 'Retour aux chapitres',
    } %}

    {% include 'includes/flash_messages.html.twig' %}

        <div class="content-container">
            <div class="form-container">
                {{ form_start(form) }}
                <div class="title-container">
                    {{ form_label(form.title, null, {'label_attr': {'class': 'title'}}) }}
                    {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.title) }}
                </div>
                <div class="content-container">
                    {{ form_label(form.content, null, {'label_attr': {'class': 'title'}}) }}
                    {{ form_widget(form.content, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.content) }}
                </div>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                {{ form_end(form) }}
            </div>
        </div>

    </div>
{% endblock %}