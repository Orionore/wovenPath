{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_home') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_home') }}
{% endblock %}

{% block main %}

    <div class="container">
        <section class="welcome-container">
            <div>
                <span>Bienvenue sur Woven Paths !</span>
                <span>Vivez des histoires où vous ferez vos propres choix.</span>
                <span>Créez des histoires de tous genres.</span>
            </div>
        </section>

        {{ form_start(form, {'attr': {'class': 'search-container'}}) }}
        {{ form_widget(form.genre) }}
        <div class="input-with-icon">
            {{ form_widget(form.query) }}
            <img src="{{ asset('build/images/pictos/search.svg') }}" alt="search">
        </div>
        {{ form_widget(form.submit) }}
        {{ form_end(form) }}

        <section class="stories-container">
            {% if stories|length > 0 %}
                <div class="row">
                    {% for story in stories %}
                        <div class="col-md-4 mb-4">
                            <div class="card">
                                <div class="card-body">
                                    <h5 class="card-title">{{ story.title }}</h5>
                                    {% if story.imageName %}
                                        <img src="{{ asset('uploads/stories/' ~ story.imageName) }}" alt="{{ story.title }}" class="img-fluid">
                                    {% else %}
                                        <img src="{{ asset('images/default/default.webp') }}" alt="{{ story.title }}" class="img-fluid">
                                    {% endif %}
                                    <p class="card-text">{{ story.description }}</p>
                                    <p class="card-text">
                                        <small class="text-muted">
                                            Genres:
                                            {% for genre in story.genre %}
                                                {{ genre.value }}{% if not loop.last %}, {% endif %}
                                            {% endfor %}
                                        </small>
                                    </p>
                                    <a href="{{ path('app_story_show', {'id': story.id}) }}" class="btn">Découvrir</a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# Navigation de pagination #}
                {% if totalPages > 1 %}
                    <nav aria-label="Navigation des pages" class="mt-4">
                        <ul class="pagination justify-content-center">
                            {% if currentPage > 1 %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_home', {'page': currentPage - 1}|merge(app.request.query.all|filter((v, k) => k != 'page'))) }}">Précédent</a>
                                </li>
                            {% else %}
                                <li class="page-item disabled">
                                    <span class="page-link">Précédent</span>
                                </li>
                            {% endif %}

                            {% for i in 1..totalPages %}
                                <li class="page-item {{ i == currentPage ? 'active' : '' }}">
                                    <a class="page-link" href="{{ path('app_home', {'page': i}|merge(app.request.query.all|filter((v, k) => k != 'page'))) }}">{{ i }}</a>
                                </li>
                            {% endfor %}

                            {% if currentPage < totalPages %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_home', {'page': currentPage + 1}|merge(app.request.query.all|filter((v, k) => k != 'page'))) }}">Suivant</a>
                                </li>
                            {% else %}
                                <li class="page-item disabled">
                                    <span class="page-link">Suivant</span>
                                </li>
                            {% endif %}
                        </ul>
                    </nav>
                {% endif %}
            {% else %}
                <div class="alert alert-info">
                    Aucune histoire trouvée.
                </div>
            {% endif %}
        </section>
    </div>

{% endblock %}