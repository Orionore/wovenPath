{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_home') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_home') }}
{% endblock %}

{% block main %}

    <div class="container">
        <section class="welcome-container">
            <h2>
                <span>Bienvenue sur Woven Paths !</span>
                <span>Vivez des histoires où vous ferez vos propres choix.</span>
                <span>Créez des histoires de tous genres.</span>
            </h2>
        </section>

        {{ form_start(form, {'attr': {'class': 'search-container'}}) }}
        {{ form_widget(form.genre) }}
        <div class="input-with-icon">
            {{ form_widget(form.query) }}
            <img src="{{ asset('build/images/pictos/search.svg') }}" alt="search">
        </div>
        {{ form_widget(form.submit, {'attr': {'class': 'btn-nav'}}) }}
        {{ form_end(form) }}

        <section class="stories-container">
            {% if stories|length > 0 %}
                <div class="grid">
                    {% for story in stories %}
                        <div class="story-container">

                            <div class="card-header">
                                <h3 class="card-title">{{ story.title }}</h3>
                                <p class="card-text">
                                    <small class="text-muted">
                                        {% for genre in story.genre %}
                                            {{ genre.value }}{% if not loop.last %}, {% endif %}
                                        {% endfor %}
                                    </small>
                                </p>
                            </div>

                            <div class="card-body">
                                {% if story.imageName %}
                                    <img src="{{ asset('uploads/stories/' ~ story.imageName) }}" alt="{{ story.title }}" class="img-fluid">
                                {% else %}
                                    <img src="{{ asset('images/default/default.webp') }}" alt="{{ story.title }}" class="img-fluid">
                                {% endif %}
                            </div>

                            <div class="card-footer">
                                <a href="{{ path('app_story_show', {'id': story.id}) }}" class="btn-primary">Découvrir</a>
                            </div>

                        </div>
                    {% endfor %}
                </div>

                {% include 'partials/nav_story_research.html.twig' %}

            {% else %}
                <div class="alert alert-info">
                    Aucune histoire trouvée.
                </div>
            {% endif %}
        </section>
    </div>

{% endblock %}