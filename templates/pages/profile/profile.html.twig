{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_profile') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_profile') }}
{% endblock %}

{% block title %}Profil{% endblock %}

{% block main %}
    <div class="container">
        <section class="profile-container">
            <h1>{{ user.username }}</h1>

            <div class="profile-info">
                <p><span class="text-secondary">Email :</span> {{ user.email }}</p>
                <p><span class="text-secondary">Compte créé le :</span> {{ user.createdAt|date('d/m/Y') }}</p>
            </div>
            <a href="{{ path('app_profile_edit') }}" class="btn-author">Modifier le profil</a>
        </section>

        <section class="stories-container">

            <h2>Mes histoires</h2>

            <div class="buttons-container">
                <a href="{{ path('app_author_stories_index') }}" class="btn-primary">
                    Voir toutes mes histoires
                </a>
                <a href="{{ path('app_author_stories_new') }}" class="btn-primary">
                    Créer une nouvelle histoire
                </a>
            </div>

            <div class="stories-list">
                {% if recentStories|length > 0 %}
                    <div class="grid">
                        {% for story in recentStories %}
                            <div class="story-container">

                                <div class="card-header">
                                    <h3>{{ story.title }}</h3>
                                    {% for genre in story.genre %}
                                        <p>Genre : {{ genre.value }}</p>
                                    {% endfor %}
                                </div>

                                <div class="card-body">
                                    {% if story.imageName %}
                                        <div class="img-container">
                                            <img src="{{ asset('uploads/stories/' ~ story.imageName) }}" alt="{{ story.title }}" class="">
                                        </div>
                                    {% else %}
                                        <div class="img-container">
                                            <span>Pas d'image</span>
                                        </div>
                                    {% endif %}
                                    <span class="statu {{ story.status ? 'published' : 'not-published' }}">
                                        {{ story.status ? 'Publié' : 'Brouillon' }}
                                    </span>
                                </div>

                                <div class="card-footer">
                                    <p class="description">{{ story.description }}</p>
                                    <div class="button-container">
                                        <a href="{{ path('app_author_stories_show', {'id': story.id}) }}" class="btn-primary">
                                            Voir plus
                                        </a>
                                    </div>
                                </div>

                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="">
                        <p class="">Vous n'avez pas encore créé d'histoires.</p>
                        <a href="{{ path('app_author_stories_new') }}" class="btn-primary">
                            Créer ma première histoire
                        </a>
                    </div>
                {% endif %}

            </div>

        </section>
    </div>


{% endblock %}