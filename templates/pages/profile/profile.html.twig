{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_profile') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_profile') }}
{% endblock %}

{% block title %}Profil{% endblock %}

{% block main %}
    <section class="profile-container">
        <h1>{{ user.username }}</h1>

        <div class="profile-info">
            <p><span class="text-secondary">Email :</span> {{ user.email }}</p>
            <p><span class="text-secondary">Compte créé le :</span> {{ user.createdAt|date('d/m/Y') }}</p>
        </div>
        <a href="{{ path('app_profile_edit') }}" class="btn">Modifier le profil</a>
    </section>

    <section class="stories-container container">

        <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-bold">Mes histoires</h2>
            <a href="{{ path('app_profile_stories_index') }}" class="btn">
                Voir toutes mes histoires
            </a>
            <a href="{{ path('app_profile_stories_new') }}" class="btn">
                Créer une nouvelle histoire
            </a>
        </div>

        {% if recentStories|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {% for story in recentStories %}
                    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                        {% if story.imageName %}
                            <img src="{{ asset('uploads/stories/' ~ story.imageName) }}" alt="{{ story.title }}" class="">
                        {% else %}
                            <div class="">
                                <span class="text-gray-500">Pas d'image</span>
                            </div>
                        {% endif %}
                        <div class="p-4">
                            <div class="">
                                <h3 class="text-lg font-semibold">{{ story.title }}</h3>
                                <span class="statu {{ story.status ? 'published' : 'not-published' }}">
                                    {{ story.status ? 'Publié' : 'Brouillon' }}
                                </span>
                            </div>
                            <p class="description">{{ story.description }}</p>
                            <a href="{{ path('app_profile_stories_show', {'id': story.id}) }}" class="btn">
                                Voir plus
                            </a>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="">
                <p class="">Vous n'avez pas encore créé d'histoires.</p>
                <a href="{{ path('app_profile_stories_new') }}" class="btn">
                    Créer ma première histoire
                </a>
            </div>
        {% endif %}

    </section>
{% endblock %}