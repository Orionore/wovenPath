{# templates/pages/profile/stories/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Modifier l'histoire{% endblock %}

{% block main %}

    <div class="container">

        {% include 'components/_nav.html.twig' with {
            'title': 'Modifier l\'histoire',
            'return_path': path('app_profile_stories_index'),
            'return_text': 'Retour à la liste',
        } %}

        {% include 'includes/flash_messages.html.twig' %}

        <div class="bg-white rounded-lg shadow-lg p-6">
            {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            <div>
                {{ form_label(form.title, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.title, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500'}}) }}
                {{ form_errors(form.title, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
            </div>

            <div>
                {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                {{ form_widget(form.description, {'attr': {'class': 'mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500'}}) }}
                {{ form_errors(form.description, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
            </div>

            <div>
                {{ form_label(form.genre, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
                    {% for child in form.genre %}
                        <div class="flex items-start">
                            {{ form_widget(child, {'attr': {'class': 'h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 mr-2 mt-1'}}) }}
                            {{ form_label(child, null, {'label_attr': {'class': 'text-sm text-gray-700'}}) }}
                        </div>
                    {% endfor %}
                </div>
                {{ form_errors(form.genre, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
            </div>

            <div>
                {{ form_label(form.imageFile, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                <div
                    {{ stimulus_controller('story-image-preview') }}
                    class="mt-1"
                >
                    {% if story.imageName %}
                        <div class="mb-3">
                            <p class="text-sm text-gray-600 mb-1">Image actuelle:</p>
                            <img src="{{ asset('uploads/stories/' ~ story.imageName) }}" alt="{{ story.title }}" class="max-h-48 rounded">
                        </div>
                    {% endif %}

                    {{ form_widget(form.imageFile, {
                        'attr': {
                            'class': 'block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100',
                            'data-story-image-preview-target': 'input',
                            'data-action': 'story-image-preview#preview'
                        }
                    }) }}
                    <div class="mt-2 hidden" data-story-image-preview-target="preview">
                        <p class="text-sm text-gray-600 mb-1">Nouvelle image:</p>
                        <img src="#" class="max-h-48 rounded" data-story-image-preview-target="image">
                    </div>
                </div>
                {{ form_errors(form.imageFile, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
            </div>

            <div>
                {{ form_widget(form.status, {'attr': {'class': 'h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500 mr-2'}}) }}
                {{ form_label(form.status, null, {'label_attr': {'class': 'text-sm font-medium text-gray-700'}}) }}
                {{ form_errors(form.status, {'attr': {'class': 'text-red-500 text-sm mt-1'}}) }}
            </div>

            <div class="flex justify-end">
                <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
                    Enregistrer les modifications
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}