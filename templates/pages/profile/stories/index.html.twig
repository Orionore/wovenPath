{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_profile') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_profile') }}
{% endblock %}

{% block title %}Mes histoires{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-8">
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold">Mes histoires</h1>
            <a href="{{ path('app_profile_stories_new') }}" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                Créer une histoire
            </a>
        </div>

        {% include 'includes/flash_messages.html.twig' %}

        {% if stories|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% for story in stories %}
                    <div class="bg-white rounded-lg shadow-lg overflow-hidden">
                        {% if story.imageName %}
                            <img src="{{ asset('uploads/stories/' ~ story.imageName) }}" alt="{{ story.title }}" class="w-full h-48 object-cover">
                        {% else %}
                            <div class="w-full h-48 bg-gray-200 flex items-center justify-center">
                                <span class="text-gray-500">Pas d'image</span>
                            </div>
                        {% endif %}
                        <div class="p-4">
                            <div class="flex justify-between items-start mb-2">
                                <h2 class="text-xl font-bold">{{ story.title }}</h2>
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ story.status ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' }}">
                                    {{ story.status ? 'Publié' : 'Brouillon' }}
                                </span>
                            </div>
                            <p class="text-gray-700 mb-4 line-clamp-3">{{ story.description }}</p>

                            <div class="mb-4">
                                {% for genre in story.genre %}
                                    <span class="inline-block bg-gray-100 rounded-full px-3 py-1 text-xs font-semibold text-gray-700 mr-2 mb-2">
                                    </span>
                                {% endfor %}
                            </div>

                            <div class="flex justify-between mt-4">
                                <a href="{{ path('app_profile_stories_show', {'id': story.id}) }}" class="text-blue-500 hover:text-blue-700">
                                    Voir
                                </a>
                                <a href="{{ path('app_profile_stories_edit', {'id': story.id}) }}" class="text-yellow-500 hover:text-yellow-700">
                                    Modifier
                                </a>
                                <form method="post" action="{{ path('app_profile_stories_delete', {'id': story.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette histoire ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ story.id) }}">
                                    <button class="text-red-500 hover:text-red-700 bg-transparent border-none cursor-pointer">Supprimer</button>
                                </form>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="bg-gray-100 p-8 rounded-lg text-center">
                <p class="text-lg text-gray-600 mb-4">Vous n'avez pas encore créé d'histoires.</p>
                <a href="{{ path('app_profile_stories_new') }}" class="inline-block bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                    Créer ma première histoire
                </a>
            </div>
        {% endif %}
    </div>
{% endblock %}