{% extends 'layouts/profile.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_show_story') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_show_story') }}
{% endblock %}

{% block title %}{{ story.title }}{% endblock %}

{% block main %}
    <div class="container">

        {% include 'partials/main-nav.html.twig' with {
            'title': story.title,
            'return_path': path('app_profile_stories_index'),
            'return_text': 'Retour à la liste',
            'actions': [
            {
                'path': path('app_profile_stories_edit', {'id': story.id}),
                'text': 'Modifier l\'histoire'
            },
                {
                    'path': path('app_story_chapters', {'id': story.id}),
                    'text': 'Gérer les chapitres'
                }
            ]
        } %}

        {% include 'includes/flash_messages.html.twig' %}

        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <div class="md:flex">
                <div class="md:flex-shrink-0 md:w-1/3">
                    {% if story.imageName %}
                        <img src="{{ asset('uploads/stories/' ~ story.imageName) }}" alt="{{ story.title }}">
                    {% else %}
                        <img src="{{ asset('images/default/default.webp') }}" alt="{{ story.title }}">
                    {% endif %}
                </div>
                <div class="story-information-container">
                    <div class="story-title-container">
                        <h2>{{ story.title }}</h2>
                        <span class=" {{ story.status ? 'publish' : 'unpublish' }}">
                            {{ story.status ? 'Publié' : 'Brouillon' }}
                        </span>
                    </div>

                    <div class="mb-6">
                        <h3>Description</h3>
                        <p>{{ story.description }}</p>
                    </div>

                    <div class="genre-container">
                        <h3>Genres</h3>
                        <div>
                            {% for genre in story.genre %}
                                <span>{{ genre.value }}</span>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="text-sm text-gray-500">
                        <p>Créé le: {{ story.createdAt|date('d/m/Y H:i') }}</p>
                        {% if story.updatedAt %}
                            <p>Dernière modification: {{ story.updatedAt|date('d/m/Y H:i') }}</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div>
            <a href="{{ path('app_profile_stories_edit', {'id': story.id}) }}" class="btn">
                Modifier
            </a>
            <form method="post" action="{{ path('app_profile_stories_delete', {'id': story.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette histoire ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ story.id) }}">
                <button class="btn-danger">Supprimer</button>
            </form>
        </div>

        <div class="story-activity-container">
            <h3>Activité de l'histoire</h3>

            {% if story.createdAt %}
                <div class="created-at-container">
                    <div class="picto-container">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                        </svg>
                    </div>
                    <div class="text-container">
                        <h4>Histoire créée</h4>
                        <p>{{ story.createdAt|date('d/m/Y H:i') }}</p>
                    </div>
                </div>
            {% endif %}

            {% if story.updatedAt %}
                <div class="updated-at-container">
                    <div class="picto-container">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                    </div>
                    <div class="text-container">
                        <h4>Dernière modification</h4>
                        <p>{{ story.updatedAt|date('d/m/Y H:i') }}</p>
                    </div>
                </div>
            {% endif %}

            <div class="status-at-container">
                <div class="picto-container bg-{{ story.status ? 'green' : 'yellow' }}">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>

                <div class="text-container">
                    <h4>Statut actuel</h4>
                    <p>{{ story.status ? 'Publié' : 'Brouillon' }}</p>
                </div>
            </div>

        </div>

        {% if hasChapters %}
        <div class="list-group mb-4">
            {% for chapter in chapters %}
            <a href="{{ path('app_chapter_read', {'id': chapter.id}) }}" class="list-group-item list-group-item-action">
                <div class="d-flex w-100 justify-content-between">
                    <h5 class="mb-1">{{ chapter.position }}. {{ chapter.title }}</h5>
                </div>
            </a>
            {% endfor %}
        </div>

        <div class="text-center">
            <a href="{{ path('app_story_read_first_chapter', {'storyId': story.id}) }}" class="btn btn-success">
                Commencer la lecture
            </a>
        </div>
        {% else %}
        <div class="alert alert-info">
            Cette histoire n'a pas encore de chapitres.
            {% if app.user and app.user.id == story.userId %}
            <a href="{{ path('app_chapter_new', {'id': story.id}) }}">Cliquez ici pour ajouter le premier chapitre</a>.
            {% endif %}
        </div>
        {% endif %}

    </div>

{% endblock %}