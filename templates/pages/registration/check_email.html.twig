{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_registration') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_registration') }}
{% endblock %}

{% block title %}Email de vérification{% endblock %}

{% block main %}
    <div class="card">
        <h1>Vérifiez vos emails</h1>
        <p>Un email de vérification a été envoyé à l'adresse que vous avez fournie. Veuillez vérifier votre boîte de réception et suivre les instructions pour confirmer votre adresse email.</p>
    </div>
{% endblock %}
