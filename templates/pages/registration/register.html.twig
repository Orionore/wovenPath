{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_register') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_register') }}
{% endblock %}

{% block main %}

    <body class="register-page" cz-shortcut-listen="true">

    {% for flash_error in app.flashes('verify_email_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    <div class="box">

        <div class="card">

            {% if app.user %}

            <div class="mb-3">
                Vous êtes logué en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Se déconnecter</a>
            </div>

            {% else %}

            <div class="card-body register-card-body">
                <span class="title">Créer un compte</span>

                {{ form_start(registrationForm) }}
                    {{ form_errors(registrationForm) }}
                    {{ form_rest(registrationForm) }}
                        <button type="submit" class="btn-primary">Créer un compte</button>
                {{ form_end(registrationForm) }}

                <div class="links-container">
                    <a href="{{ path('app_login') }}">
                        J'ai déjà un compte
                    </a>
                </div>

            </div> <!-- /.register-card-body -->

            {% endif %}

        </div>
    </div>
    </body>

{% endblock %}