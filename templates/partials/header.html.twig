{% block header %}
    <header data-controller="mobile-menu">
        <div class="card">
            <div class="header-container">
                {% include 'partials/logo.html.twig' %}
                <div
                    class="menu-icon mobile"
                    data-mobile-menu-target="icon"
                    data-action="click->mobile-menu#toggle"
                >
                    <div class="bar"></div>
                    <div class="bar2"></div>
                </div>

                <div class="mobile-nav" data-mobile-menu-target="menu">
                    <div class="header-nav-container">
                        <ul>
                            {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                                <li>
                                    <a href="{{ path('app_logout') }}">Se déconnecter</a>
                                </li>
                                <li>
                                    <a href="{{ path('app_author_stories_index') }}" class="nav-title"><b>Créer une histoire</b></a>
                                </li>
                                <li>
                                    <a href="{{ path('app_profile') }}" class="nav-title">Profile</a>
                                </li>
                            {% else %}
                                <li>
                                    <a href="{{ path('app_login') }}">Se connecter</a>
                                </li>
                                <li>
                                    <a href="{{ path('app_login') }}" class="nav-title"><b>Créer une histoire</b></a>
                                </li>
                            {% endif %}

                            <li>
                                <a href="#" class="nav-title">Contact</a>
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </header>
{% endblock %}