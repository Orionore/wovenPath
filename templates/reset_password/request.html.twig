{% extends 'layouts/main.html.twig' %}

{% block title %}Reset your password{% endblock %}

{% block body %}
<div class="box">

    <div class="logo">
        <img src="{{ asset('build/images/on-compare/logo-on-compare-RVB-couleur.svg') }}" alt="on compare login page">
        <span>On Compare</span>
    </div>

    {% for flash_error in app.flashes('reset_password_error') %}
        <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
    {% endfor %}

    <div class="card">

        <span class="title">Changer votre mot de passe</span>

        {{ form_start(requestForm) }}
            {{ form_row(requestForm.email) }}
            <div>
                <small>
                    Entrez votre mail et nous vous envoyons un lien de changement de mot de passe
                </small>
            </div>

            <button class="btn btn-primary">Envoyer le lien</button>
        {{ form_end(requestForm) }}
    </div>

</div>
{% endblock %}