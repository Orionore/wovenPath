{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_reset_password') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_reset_password') }}
{% endblock %}

{% block title %}Modifier votre mot de passe{% endblock %}

{% block main %}
    <div class="container">
        <h1>Modifier votre mot de passe</h1>

        {{ form_start(resetForm) }}
        {{ form_row(resetForm.plainPassword) }}
        <button class="btn btn-primary">Modifier mon mot de passe</button>
        {{ form_end(resetForm) }}
    </div>

{% endblock %}
