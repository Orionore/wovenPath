{% extends 'layouts/main.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('page_login') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('page_login') }}
{% endblock %}

{% block main %}
    <body class="login-page">

    <div class="box">
        <!-- /.login-logo -->
        <div class="card">

            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            {% if app.user %}

                <div class="mb-3">
                    Vous êtes logué en tant que {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Se déconnecter</a>
                </div>

            {% else %}

                <span class="title">Connectez-vous</span>

                <form action="{{ path('app_login') }}" method="post">

                    <label class="form-controls">
                        <input type="email" class="email" id="email" name="email" placeholder="Email" required />
                    </label>
                    <label class="form-controls">
                        <input type="password" class="password" id="password" name="password" placeholder="Password" required />
                    </label>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="_remember_me" id="flexCheckDefault" />
                        <label class="form-check-label" for="flexCheckDefault">
                            Se souvenir de moi
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary">Se connecter</button>

                </form>


                <div class="links-container">
                    <a href="{{ path('app_forgot_password_request') }}">
                        J'ai oublié mon mot de passe
                    </a>
                    <a href="{{ path('app_register') }}">
                        Créer un nouveau compte
                    </a>
                </div>

            {% endif %}

        </div>
        <!-- /.login-card-body -->
    </div>
    <!-- /.login-box -->

    </body>
{% endblock %}